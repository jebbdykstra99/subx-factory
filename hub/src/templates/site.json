{
  "siteId": "subx",
  "domain": "{{brand.primaryDomain}}",
  "name": "{{brand.name}}",
  "tagline": "{{brand.tagline}}",
  "accountsOpen": false,
  "pixel": false,
  "whoMark": true,
  "minAge": 18,
  "dms": false,
  "imageUploads": false,
  "earlyWelcome": false,
  "composePlaceholder": "The hub is read-only. Post in a {{brand.roomNoun.one}}.",
  "emptyState": "The hub is read-only. Pick a {{brand.roomNoun.one}} to read or post.",
  "trustBlurb": "Read-only hub. Highlights link back to the original post in its {{brand.roomNoun.one}}.",
  "exploreExplainer": "Every {{brand.name}} {{brand.roomNoun.one}}, one hop away.",
  "theme": {
    "bg": "#f3f1ec",
    "surface": "#fbfaf7",
    "nav-bg": "#121214",
    "nav-text": "#b9b4aa",
    "nav-hover": "#f1ede4",
    "nav-active": "#fbfaf7",
    "text": "#18171a",
    "text-muted": "#57534c",
    "text-light": "#8b867c",
    "accent": "#a11d33",
    "accent-dark": "#7d1426",
    "teal": "#7d1426",
    "silver": "#cfcac0",
    "border": "#e2ddd3",
    "avatarColors": [
      "#121214",
      "#a11d33",
      "#3a3a40",
      "#7d1426",
      "#5a554c",
      "#26262b"
    ]
  },
  "rail": {
    "kind": "room-brief",
    "kicker": "Live {{brand.name}} {{brand.roomNoun.many}}",
    "title": "Suggested {{brand.roomNoun.many}}",
    "footer": "Each {{brand.roomNoun.one}} has its own rules. Paused {{brand.roomNoun.many}} are not listed.",
    "meta": "{{brand.roomNoun.One}}",
    "maxCards": 15,
    "outbound": []
  },
  "trends": [],
  "places": [],
  "topics": [],
  "nests": [],
  "shell": {
    "base": "{{shell.base}}",
    "fork": false,
    "cspRequired": true,
    "overrides": {
      "theme": [
        "styles.css",
        "nests.css",
        "hub.css"
      ],
      "copy": [
        "site.json:name",
        "site.json:tagline",
        "site.json:rail"
      ],
      "legal": [
        "terms.html",
        "privacy.html",
        "guidelines.html",
        "report.html",
        "about.html"
      ]
    },
    "keep": [
      {
        "file": "assets/whomark/whomark.js",
        "sha256": "",
        "reason": "{{brand.disclosureMark}} disclosure badges (vendored byte copy of subx-factory assets/whomark, re-branded only when brand.json changes)",
        "noShellOk": true
      },
      {
        "file": "hub.js",
        "sha256": "",
        "reason": "hub: renders highlights.json + rooms.json (read-only, no auth, no writes)",
        "noShellOk": true
      },
      {
        "file": "takedown.js",
        "sha256": "",
        "reason": "hub: takedown/report mailto from brand.json takedownEmail",
        "noShellOk": true
      }
    ],
    "notes": "Generated by tools/brand_render.py from brand/brand.json + hub/src; keep sha256 values are filled at render time.",
    "noShell": [
      "rooms.html",
      "about.html",
      "{{brand.topicPathPrefix}}index.html",
      "terms.html",
      "privacy.html",
      "guidelines.html",
      "report.html",
      "404.html"
    ]
  }
}
