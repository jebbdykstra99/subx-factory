{
  "siteId": "subx",
  "domain": "{{brand.primaryDomain}}",
  "name": "{{brand.name}}",
  "tagline": "{{brand.tagline}}",
  "accountsOpen": true,
  "pixel": false,
  "whoMark": true,
  "minAge": 18,
  "dms": false,
  "imageUploads": false,
  "stories": { "enabled": false },
  "earlyWelcome": false,
  "composePlaceholder": "Posts live in the {{brand.roomNoun.many}}. Post in a {{brand.roomNoun.one}}.",
  "emptyState": "Posts live in the {{brand.roomNoun.many}}. Pick a {{brand.roomNoun.one}} to read or post.",
  "trustBlurb": "Sign in here, post in the {{brand.roomNoun.many}}. Highlights link back to the original post in its {{brand.roomNoun.one}}.",
  "exploreExplainer": "Every {{brand.name}} {{brand.roomNoun.one}}, one hop away.",
  "theme": {
    "bg": "#ffffff",
    "surface": "#f7f9f9",
    "nav-bg": "#ffffff",
    "nav-text": "#0f1419",
    "nav-hover": "#0f1419",
    "nav-active": "#0f1419",
    "text": "#0f1419",
    "text-strong": "#0f1419",
    "text-muted": "#536471",
    "text-light": "#536471",
    "accent": "#1d9bf0",
    "accent-dark": "#1a8cd8",
    "teal": "#1d9bf0",
    "silver": "#cfd9de",
    "border": "#eff3f4",
    "widget": "#eff3f4",
    "primary-bg": "#0f1419",
    "primary-fg": "#ffffff",
    "primary-hover": "#272c30",
    "hover-surface": "#f7f9f9",
    "focus": "#1d9bf0",
    "border-strong": "#cfd9de",
    "avatarColors": [
      "#16181c",
      "#2f3336",
      "#3d4450",
      "#202327",
      "#25282c",
      "#3a4148"
    ]
  },
  "rail": {
    "kind": "room-brief",
    "kicker": "Live {{brand.name}} {{brand.roomNoun.many}}",
    "title": "Suggested {{brand.roomNoun.many}}",
    "footer": "Each {{brand.roomNoun.one}} has its own rules. Paused {{brand.roomNoun.many}} are not listed.",
    "meta": "{{brand.roomNoun.One}}",
    "maxCards": 15,
    "outbound": []
  },
  "trends": [],
  "places": [],
  "topics": [],
  "nests": [],
  "shell": {
    "base": "{{shell.base}}",
    "fork": false,
    "cspRequired": true,
    "recaptcha": true,
    "googleSignIn": true,
    "overrides": {
      "theme": [
        "styles.css",
        "nests.css",
        "hub.css"
      ],
      "copy": [
        "site.json:name",
        "site.json:tagline",
        "site.json:rail"
      ],
      "legal": [
        "terms.html",
        "privacy.html",
        "guidelines.html",
        "report.html",
        "about.html"
      ]
    },
    "keep": [
      {
        "file": "assets/whomark/whomark.js",
        "sha256": "",
        "reason": "{{brand.disclosureMark}} disclosure marks, final-v4.1 art (vendored from hub/src/whomark, re-branded only when brand.json changes)",
        "noShellOk": true
      },
      {
        "file": "hub.js",
        "sha256": "",
        "reason": "hub: renders highlights.json + rooms.json, and the header Sign in / Join button that opens the shell sign-in (no writes of its own)",
        "noShellOk": true
      },
      {
        "file": "takedown.js",
        "sha256": "",
        "reason": "hub: takedown/report mailto from brand.json takedownEmail",
        "noShellOk": true
      },
      {
        "file": "theme.js",
        "sha256": "",
        "reason": "hub: optional Lights Out toggle, stored only in this browser",
        "noShellOk": true
      }
    ],
    "notes": "Generated by tools/brand_render.py from brand/brand.json + hub/src; keep sha256 values are filled at render time.",
    "noShell": [
      "rooms.html",
      "about.html",
      "{{brand.topicPathPrefix}}index.html",
      "terms.html",
      "privacy.html",
      "guidelines.html",
      "report.html",
      "partners.html",
      "partners/dogacademy/index.html",
      "404.html"
    ]
  }
}
