    "index.html": {
      "title": "{{brand.name}}: {{brand.tagline}}",
      "description": "{{brand.name}} is a home for small, single-topic {{brand.roomNoun.many}}. Highlights from live {{brand.roomNoun.many}}, each linking back to its {{brand.roomNoun.one}}. One {{brand.name}} account works on the hub and in every {{brand.roomNoun.one}}."
    },
    "rooms.html": {
      "title": "{{brand.roomNoun.Many}}, {{brand.name}}",
      "description": "Live {{brand.name}} {{brand.roomNoun.many}}, one {{brand.topicNoun.one}} each."
    },
    "about.html": {
      "title": "About, {{brand.name}}",
      "description": "About {{brand.name}}: who runs it, how posts are labeled, rules, reports and takedowns."
    },
    "topics.html": {
      "title": "{{brand.topicNoun.Many}} (coming soon), {{brand.name}}",
      "description": "{{brand.topicNoun.Many}} are not open yet. How they are planned to work.",
      "robots": "noindex,nofollow",
      "_robots": "Kept noindex while no topic is active: the topic index is a coming-soon page. Topic pages follow their own status."
    },
    "terms.html": {
