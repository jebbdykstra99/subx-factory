{
  "hosting": {
    "target": "hub",
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "script-src 'self' https://cdn.jsdelivr.net/gh/jebbdykstra99/subx-factory@88ce6dc1fe9b2d7fce809695e8ac4ef94ec89236/shell/v1.2.6/; object-src 'none'; base-uri 'none'; font-src 'self'; frame-ancestors 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      }
    ]
  }
}
