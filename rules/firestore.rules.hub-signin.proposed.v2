rules_version = '2';
// RETENTION NOTE (2026-10-12, CLO): pixel `hits` rows carry expireAt = createdAt + 90d and are removed
// by a Firestore TTL policy on `expireAt` (Admin SDK writes; these client rules don't govern them).
// TTL deletion is not instant: Firestore typically deletes within ~24 h AFTER expireAt, so a raw row
// can live ~91 days. Aggregates: up to 13 months (expireAt = periodEnd + 395d) if a rollup is added.
// GPCHAT LIFT (2026-10-18 rebuild): this file = the v2 rules paste file, SECTION A2 (v2: follow/mute fix,
// story guard, burst cap) + the gpchat lift deltas U3 (no uploads/stories in gpchat) and R2 (under-18 suspension).
// The Oct 17 draft was built on v1 SECTION A and dropped the v2 follow/mute/story fixes for all 20 rooms.
// AUTOHIDE-ON-REPORT (2026-10-22, 4:42 PM MT): amended copy of f93194e3d2175c7149b7201b31553b2b.
// Adds /hides/{hideId} public hide markers (atomic with a hide-eligible report in ['ncii','impersonation','csam']
// or by admin; ONLY admin o774wL9hUVSi19EkDCgLqQomP8i2 can delete/restore; never updated), splits /posts and
// /stories read into list + get (denying single-doc get when hidden for non-admin), and adds optional per-user
// hide rate-limit keys (lastHideAt 60s gap, hideDay/hideDayCount <= 5/UTC day) on /rateLimits/{uid}.
// HUB SIGN-IN (2026-11-04, draft, NOT published): amended copy of firestore.rules.proposed.
// Lets the subx.it hub (siteId 'subx') hold accounts WITHOUT making it a posting room.
// 'subx' is accepted ONLY for: users/{uid} profile, blocks, following, mutes, follow notifications,
// and (only when hubDmOn() returns true) DMs whose conversation siteId is 'subx'. posts, stories, reports,
// hides, bookmarks, hidden, memberNests stay factorySite() only, so the hub stays read-only for posts.
// HUB DM TOGGLE (2026-11-04): hubDmOn() is a single-line switch: false (OFF) in firestore.rules.hub-signin.proposed,
// true (ON) in firestore.rules.hub-signin.proposed.dm-on. It only gates conversations/messages docs with siteId 'subx'.
// Room DMs (siteId in factorySite()) are allowed by factorySite() alone in both files, so they do not change.
// UNDER-18 FIELD LOCK (2026-11-07, draft, NOT published): amended copy of firestore.rules.hub-signin.proposed.
// Owner writes cannot drop or rewrite a persisted deletionQueuedAt, cannot change a persisted
// suspendedReason or profileHidden on an already-restricted users/{uid} doc, and cannot transition
// ageConfirmed or ageAttested18 to true while restricted. Restricted means suspended:true,
// suspendedReason == 'under18', or deletionQueuedAt present, on the existing doc OR the resulting doc.
// An unchanged legacy ageConfirmed:true stays writable. Applies on create. suspendOk's isAdmin()
// exemption is unchanged. Not deployed.
// HANDLES (2026-11-07, draft, NOT published): 27chat PR 53 (824dfbe5). One shared namespace.
// Signed-in get only; list is denied. Create pairs with users.handle in the same transaction.
// No update. Delete only when the profile handle no longer points at that id. A suspended or
// profileHidden account cannot claim or change users.handle. Reserved names, including j32b,
// are not client-claimable. Not deployed.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == 'o774wL9hUVSi19EkDCgLqQomP8i2';
    }
    // GROWTH CONSOLE (2026-10-22): authorType is 'human' or 'steward'; only the admin may write 'steward'.
    // Omitted is still allowed (rooms on factory <= v1.2.0 do not send it).
    function authorTypeOk(d) {
      return !d.keys().hasAny(['authorType'])
        || d.authorType == 'human'
        || (isAdmin() && d.authorType == 'steward');
    }
    // Short + long siteId forms used across live skins / posts
    function factorySite(data) {
      return data.siteId in [
        'samochat', 'bartchat', '415chat', 'gpchat', '27chat', '808chat',
        'buffettchat', 'gaichat', 'popechat', 'recruitchat', '311chat',
        'booze', 'buffet', 'boyfriend', 'cia', 'cobra',
        'airlines', 'airlineschat', 'ama', 'amachat', 'atm', 'atmchat',
        'behindtheblackwall', 'btbw'
      ];
    }
    // HUB SIGN-IN: the subx.it hub. Accounts and follows; DMs only behind hubDmOn(); never posts or stories.
    function hubSite(data) {
      return data.siteId == 'subx';
    }
    function memberSite(data) {
      return factorySite(data) || hubSite(data);
    }
    // HUB DM TOGGLE: the ONLY line that differs from the .dm-on file. false = hub ('subx') DMs off; true = on.
    function hubDmOn() { return false; }
    // DM site check: room DMs always; hub ('subx') DMs only while hubDmOn() is true.
    function dmSite(data) {
      return factorySite(data) || (hubDmOn() && hubSite(data));
    }
    function nestSlugOk(slug) {
      return slug is string
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && slug.size() >= 2
        && slug.size() <= 40
        && !(slug in [
          'home', 'explore', 'following', 'notifications', 'chat', 'profile', 'news',
          'about', 'terms', 'privacy', 'api', 'admin', 'watchlist', 'stories',
          'feed', 'thoughts', 'hot', 'new'
        ]);
    }
    function notKilled(sid) {
      return !exists(/databases/$(database)/documents/sites/$(sid))
        || get(/databases/$(database)/documents/sites/$(sid)).data.killed != true;
    }
    function hasPostBody(data) {
      return (data.text is string && data.text.size() > 0)
        || (data.keys().hasAll(['imageUrl']) && data.imageUrl is string && data.imageUrl.size() > 0)
        || (data.keys().hasAll(['poll']) && data.poll is map)
        || (data.keys().hasAll(['repostOf']) && data.repostOf is string && data.repostOf.size() > 0)
        || (data.keys().hasAll(['quoteOf']) && data.quoteOf is string && data.quoteOf.size() > 0
            && data.text is string && data.text.size() > 0);
    }
    function textOk(data) {
      return !data.keys().hasAny(['text'])
        || (data.text is string && data.text.size() <= 280);
    }
    function onlyReplyCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount == (resource.data.replyCount is int ? resource.data.replyCount : 0) + 1;
    }
    function onlyOwnPollVote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        && request.resource.data.poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
        && request.resource.data.poll.votes.diff(resource.data.poll.votes).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.poll.votes[request.auth.uid] is int;
    }
    function uidMap(data, field) {
      return data.keys().hasAny([field]) && data[field] is map ? data[field] : {};
    }
    function onlyOwnUidMap(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && uidMap(request.resource.data, field).diff(uidMap(resource.data, field)).affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data[field][request.auth.uid] == true
          || !(request.auth.uid in request.resource.data[field])
        );
    }
    function onlyOwnLike() {
      return onlyOwnUidMap('likes');
    }
    function onlyOwnRepost() {
      return onlyOwnUidMap('reposts');
    }
    function onlyOwnPostEdit() {
      return resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.siteId == resource.data.siteId;
    }
    function ownEdge(targetUid) {
      return emailVerified()
        && request.auth.uid == uid
        && request.auth.uid != targetUid
        && factorySite(request.resource.data)
        && request.resource.data.siteId is string;
    }
    function twoParticipants(data) {
      return data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string
        && data.participants[1] is string
        && data.participants[0] != data.participants[1];
    }
    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }
    function dmUnreadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['unreadCounts', 'lastMessage', 'lastMessageAt', 'lastMessageBy', 'participantNames'])
        && request.resource.data.siteId == resource.data.siteId
        && request.resource.data.participants == resource.data.participants;
    }
    function hasStoryFields(data) {
      return data.keys().hasAll(['siteId', 'authorUid', 'type', 'createdAt', 'expiresAt'])
        && data.siteId is string
        && data.authorUid is string
        && data.type in ['text', 'image', 'video']
        && data.createdAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt >= data.createdAt + duration.value(20, 'h')
        && data.expiresAt <= data.createdAt + duration.value(28, 'h');
    }


    // ===== PREVIEW-LIFT GUARD (draft 2026-10-09; SubX hand-publishes) =====
    // Rooms whose factory.js writes rateLimits/{uid} in the same batch as a post/DM.
    // Add a siteId here ONLY after that room's live factory.js carries the guard block
    // (check: allrooms/guarded-line.sh prints the exact line). Use the site.json siteId,
    // NOT the domain: booze, buffet, boyfriend, cia, cobra are short; buffettchat is long.
    // All 20 live siteIds (verified against live site.json, Oct 9 2026):
    //   '27chat','311chat','415chat','808chat','airlineschat','amachat','atmchat','bartchat',
    //   'behindtheblackwall','booze','boyfriend','buffet','buffettchat','cia','cobra',
    //   'gaichat','gpchat','popechat','recruitchat','samochat'
    // v2 PUBLISH ORDER: paste with [] (no client change needed); later change ONLY this line.
    function guardedSite(sid) {
      return sid in ['gpchat'];
    }
    function rlPath() {
      return /databases/$(database)/documents/rateLimits/$(request.auth.uid);
    }
    // The batch that creates the post must also bump rateLimits/{uid}.lastPostAt
    // to request.time; the rateLimits rule enforces the gap, daily cap and burst cap.
    function postThrottled(sid) {
      return isAdmin() || !guardedSite(sid)
        || (existsAfter(rlPath()) && getAfter(rlPath()).data.lastPostAt == request.time);
    }
    function msgThrottled(sid) {
      return isAdmin() || !guardedSite(sid)
        || (existsAfter(rlPath()) && getAfter(rlPath()).data.lastMsgAt == request.time);
    }
    // At most 2 links per text; no common spam patterns. Severe-term list = decision D4.
    function linksOk(t) {
      return !t.lower().matches('(?s).*(https?://|www[.]).*(https?://|www[.]).*(https?://|www[.]).*');
    }
    function spamFree(t) {
      return !t.lower().matches('(?s).*(bit[.]ly/|tinyurl[.]com|t[.]me/|wa[.]me/|onlyfans[.]com|free crypto|crypto giveaway|airdrop claim|dm me on telegram|whatsapp me).*');
    }
    function cleanText(t) {
      return t is string && t.size() <= 280 && linksOk(t) && spamFree(t);
    }
    function nameOk(n) {
      return n is string && n.size() > 0 && n.size() <= 50
        && !n.lower().matches('(?s).*\\b(admin|administrator|moderator|mod team|official|staff|support team|steward)\\b.*')
        // Practical look-alikes only. Leetspeak tokens, plus Cyrillic a/o and Greek omicron
        // spoofs of admin/official. Rules have no confusable-normalize, so unlisted homoglyphs pass.
        && !n.lower().matches('(?s).*(\\badm1n\\b|\\b4dmin\\b|\\b0fficial\\b|\\bst3ward\\b|аdmin|аdministrator|οfficial|оfficial).*');
    }
    function handleOk(h) {
      return h is string && h.matches('^[a-z0-9_]{1,15}$')
        && !(h in ['mod', 'mods', 'staff', 'support', 'steward', 'system', 'root', 'team'])
        && !h.matches('^(admin|moderator|official|subx|jebb).*')
        && !h.matches('.*(adm1n|4dmin|0fficial|st3ward).*');
    }
    // Exact names no client may claim, including isAdmin(). The admin SDK migration
    // assigns these and bypasses rules. j32b is reserved for that script.
    function reservedHandle(h) {
      return h in [
        'j32b', 'admin', 'subx', 'support', 'takedown',
        'moderator', 'official', 'jebb',
        'mod', 'mods', 'staff', 'steward', 'system', 'root', 'team'
      ];
    }
    // HANDLES document id. Same charset and leetspeak as factory.js handleOk.
    // Prefixes admin|moderator|official|subx|jebb are refused for every client.
    function claimHandleOk(h) {
      return h is string && h.matches('^[a-z0-9_]{1,15}$')
        && !reservedHandle(h)
        && !h.matches('.*(adm1n|4dmin|0fficial|st3ward).*')
        && !h.matches('^(admin|moderator|official|subx|jebb).*');
    }
    function postKeysOk(d) {
      return d.keys().hasOnly([
        'siteId', 'parentId', 'authorUid', 'authorName', 'authorHandle', 'text',
        'likes', 'likeCount', 'replyCount', 'reposts', 'repostCount', 'nestSlug',
        'createdAt', 'imageUrl', 'poll', 'repostOf', 'quoteOf', 'topicIds',
        'steward', 'authorType'                                // GROWTH CONSOLE
      ]);
    }
    function pollOk(d) {
      return !d.keys().hasAny(['poll'])
        || (d.poll is map
            && d.poll.options is list && d.poll.options.size() >= 2 && d.poll.options.size() <= 4
            && d.poll.votes == {}
            && d.poll.duration is int && d.poll.duration >= 1 && d.poll.duration <= 7);
    }
    function imageOk(d) {
      return !d.keys().hasAny(['imageUrl'])
        || (d.imageUrl is string && d.imageUrl.size() <= 600
            && d.imageUrl.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/subx-skins[.]firebasestorage[.]app/o/posts%2F.*'));
    }
    function parentOk(d) {
      return !d.keys().hasAny(['parentId']) || d.parentId == null
        || (d.parentId is string
            && exists(/databases/$(database)/documents/posts/$(d.parentId))
            && get(/databases/$(database)/documents/posts/$(d.parentId)).data.siteId == d.siteId);
    }
    // Member posts: server time, zero counters, sane identity, clean text.
    // Admin (steward seeding) keeps today's behavior.
    function memberPostOk(d) {
      return isAdmin() || (
        postKeysOk(d)
        && d.createdAt == request.time
        && (!d.keys().hasAny(['likes']) || d.likes == {})
        && (!d.keys().hasAny(['likeCount']) || d.likeCount == 0)
        && (!d.keys().hasAny(['replyCount']) || d.replyCount == 0)
        && (!d.keys().hasAny(['reposts']) || d.reposts == {})
        && (!d.keys().hasAny(['steward']) || d.steward == false)   // CLO #6: only stewards (admin) may set steward:true
        && (!d.keys().hasAny(['repostCount']) || d.repostCount == 0)
        && nameOk(d.authorName)
        && handleOk(d.authorHandle)
        && (!d.keys().hasAny(['text']) || cleanText(d.text))
        && (!d.keys().hasAny(['nestSlug']) || (d.nestSlug is string && d.nestSlug.size() <= 40))
        && pollOk(d)
        && imageOk(d)
        && parentOk(d)
      );
    }
    function profileOk(d) {
      return isAdmin() || (
        (!d.keys().hasAny(['displayName']) || nameOk(d.displayName))
        && (!d.keys().hasAny(['name']) || nameOk(d.name))
        && (!d.keys().hasAny(['handle']) || handleOk(d.handle))
        && (!d.keys().hasAny(['bio']) || (d.bio is string && d.bio.size() <= 160))
        && !d.keys().hasAny(['role', 'admin', 'isAdmin', 'verified', 'steward'])
      );
    }
    // v2 (2026-10-10): member stories get the same identity/text guards as posts.
    // Clients set createdAt from the device clock (Timestamp.now()), so allow +-15 min
    // instead of == request.time. Stops a 2099 story (never expires) and fake likeCount.
    function memberStoryOk(d) {
      return isAdmin() || (
        d.keys().hasOnly([
          'siteId', 'authorUid', 'authorName', 'authorHandle', 'type', 'createdAt',
          'expiresAt', 'likeCount', 'text', 'mediaUrl', 'mediaContentType', 'posterUrl',
          'authorType'                                         // GROWTH CONSOLE
        ])
        && d.createdAt > request.time - duration.value(15, 'm')
        && d.createdAt < request.time + duration.value(15, 'm')
        && nameOk(d.authorName)
        && handleOk(d.authorHandle)
        && (!d.keys().hasAny(['likeCount']) || d.likeCount == 0)
        && (!d.keys().hasAny(['text']) || cleanText(d.text))
        && (!d.keys().hasAny(['mediaUrl'])
            || (d.mediaUrl is string && d.mediaUrl.size() <= 600
                && d.mediaUrl.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/subx-skins[.]firebasestorage[.]app/o/stories%2F.*')))
      );
    }
    // GPCHAT LIFT (Oct 17, 2026 local): uploads/stories off per room (CLO U3), R2 under-18 suspension.
    function noUploadsSite(sid) {
      return sid in ['gpchat'];
    }
    function noUploadFields(d) {
      return !(noUploadsSite(d.siteId) && d.keys().hasAny(['imageUrl', 'images', 'storyUrl']));
    }
    function notSuspended() {
      return isAdmin() || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true;
    }
    // Restricted when this map carries an under-18 marker.
    function under18Restricted(data) {
      return data.get('suspended', false) == true
        || data.get('suspendedReason', '') == 'under18'
        || data.keys().hasAny(['deletionQueuedAt']);
    }
    // True only when this write makes the field boolean true. A value that is already true
    // (legacy ageConfirmed left in place by the under-18 merge) is not a transition.
    function ageConfirmedBecomesTrue() {
      return request.resource.data.get('ageConfirmed', false) == true
        && (resource == null || resource.data.get('ageConfirmed', false) != true);
    }
    function ageAttestedBecomesTrue() {
      return request.resource.data.get('ageAttested18', false) == true
        && (resource == null || resource.data.get('ageAttested18', false) != true);
    }
    // Once the field is persisted on an already-restricted doc, keep that exact value.
    // A missing field may be filled. Called only when resource != null.
    function queuePreserved(d) {
      return !resource.data.keys().hasAny(['deletionQueuedAt'])
        || (d.keys().hasAny(['deletionQueuedAt'])
            && d.deletionQueuedAt == resource.data.deletionQueuedAt);
    }
    function reasonPreserved(d) {
      return !resource.data.keys().hasAny(['suspendedReason'])
        || (d.keys().hasAny(['suspendedReason'])
            && d.suspendedReason == resource.data.suspendedReason);
    }
    function hiddenPreserved(d) {
      return !resource.data.keys().hasAny(['profileHidden'])
        || (d.keys().hasAny(['profileHidden'])
            && d.profileHidden == resource.data.profileHidden);
    }
    // A member may set suspended:true on themself (R2 self-report under 18) but never clear it.
    // UNDER-18 FIELD LOCK: isAdmin() remains the only exemption. The new checks also run on create
    // (resource == null). Deleting a marker cannot evade them, because the existing doc is checked too.
    function suspendOk(d) {
      return isAdmin() || (
        (!d.keys().hasAny(['suspended']) || d.suspended == true)
        && (resource == null || resource.data.get('suspended', false) != true
            || request.resource.data.get('suspended', false) == true)
        && (!d.keys().hasAny(['ageAttested18']) || d.ageAttested18 is bool)
        && !(d.get('ageAttested18', false) == true && d.get('suspended', false) == true)
        && !d.keys().hasAny(['dob', 'birthDate', 'dateOfBirth'])
        && (
          !(
            (resource != null && under18Restricted(resource.data))
            || under18Restricted(d)
          )
          || (!ageConfirmedBecomesTrue() && !ageAttestedBecomesTrue())
        )
        && (
          resource == null
          || !under18Restricted(resource.data)
          || (queuePreserved(d) && reasonPreserved(d) && hiddenPreserved(d))
        )
        && ageAttestedAtLocked(d)
      );
    }
    // While suspended or deletion-queued (existing or resulting doc), ageAttestedAt
    // cannot be added, removed, or rewritten. Setting ageConfirmed or ageAttested18
    // to false, or removing them, stays allowed.
    function suspendedOrQueued(data) {
      return data.get('suspended', false) == true
        || data.keys().hasAny(['deletionQueuedAt']);
    }
    function ageAttestedAtLocked(d) {
      return !(
          (resource != null && suspendedOrQueued(resource.data))
          || suspendedOrQueued(d)
        )
        || (
          (resource == null || !resource.data.keys().hasAny(['ageAttestedAt']))
            ? !d.keys().hasAny(['ageAttestedAt'])
            : (d.keys().hasAny(['ageAttestedAt'])
                && d.ageAttestedAt == resource.data.ageAttestedAt)
        );
    }
    function handleUnchanged(d) {
      return resource != null
        && resource.data.keys().hasAny(['handle'])
        && d.keys().hasAny(['handle'])
        && resource.data.handle == d.handle;
    }
    function handleAbsentBoth(d) {
      return !d.keys().hasAny(['handle'])
        && (resource == null || !resource.data.keys().hasAny(['handle']));
    }
    function handleRemoved(d) {
      return !d.keys().hasAny(['handle'])
        && resource != null
        && resource.data.keys().hasAny(['handle']);
    }
    // Resulting users doc, so a same-transaction suspend/hide is visible.
    function callerHandleBlocked() {
      return existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) == true
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('profileHidden', false) == true
        );
    }
    // Replacing or clearing a handle must delete a claim this uid owns.
    // A claim owned by someone else is left in place. An unchanged handle is not released.
    function ownedOldClaimReleased(d) {
      return resource == null
        || !resource.data.keys().hasAny(['handle'])
        || (d.keys().hasAny(['handle']) && resource.data.handle == d.handle)
        || !exists(/databases/$(database)/documents/handles/$(resource.data.handle))
        || get(/databases/$(database)/documents/handles/$(resource.data.handle)).data.get('uid', '') != request.auth.uid
        || !existsAfter(/databases/$(database)/documents/handles/$(resource.data.handle));
    }
    // users/{uid} has no key allowlist. An unchanged handle does not need a claim, so a
    // profile that already stored one stays writable. A set or change requires the new
    // claim and is refused while this account is suspended or profileHidden.
    function handleLinkOk(d) {
      return (handleAbsentBoth(d) || handleUnchanged(d)
          || (handleRemoved(d) && !callerHandleBlocked())
          || (d.keys().hasAny(['handle']) && d.handle is string && !callerHandleBlocked()
              && existsAfter(/databases/$(database)/documents/handles/$(d.handle))
              && getAfter(/databases/$(database)/documents/handles/$(d.handle)).data.uid == request.auth.uid))
        && ownedOldClaimReleased(d);
    }
    // ===== END PREVIEW-LIFT GUARD helpers =====

    match /posts/{postId} {
      // AUTOHIDE-ON-REPORT (2026-10-22): list stays open so room feed queries never fail whole-query;
      // single-doc get is denied to non-admin once hides/{siteId}_{postId} exists.
      allow list: if true;
      allow get: if isAdmin()
        || !exists(/databases/$(database)/documents/hides/$(resource.data.siteId + '_' + postId));
      allow create: if emailVerified()
        && notKilled(request.resource.data.siteId)
        && request.auth.uid == request.resource.data.authorUid
        && factorySite(request.resource.data)
        && hasPostBody(request.resource.data)
        && textOk(request.resource.data)
        && memberPostOk(request.resource.data)                 // PREVIEW-LIFT GUARD
        && authorTypeOk(request.resource.data)                 // GROWTH CONSOLE
        && noUploadFields(request.resource.data)               // GPCHAT LIFT U3
        && notSuspended()                                      // GPCHAT LIFT R2
        && postThrottled(request.resource.data.siteId);        // PREVIEW-LIFT GUARD
      // PREVIEW-LIFT GUARD: admin takedown from the app (was author-only).
      allow delete: if isAdmin() || (signedIn()
        && resource.data.authorUid == request.auth.uid);
      allow update: if emailVerified() && notKilled(resource.data.siteId) && (
        onlyReplyCountBump()
        || onlyOwnPollVote()
        || onlyOwnLike()
        || onlyOwnRepost()
        || onlyOwnPostEdit()
      );
    }

    // CLO #7 PRIVACY: users/{uid} is owner + admin (steward) only, for get AND list.
    // Verified Oct 8: public GET of users/<uid> and list both return 403 in prod.
    // No client reads another member's users doc (names come from posts / DM participantNames),
    // so no public profile doc is needed. Private fields (email, phone) may never be written.
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['siteId'])
        && memberSite(request.resource.data)                       // HUB SIGN-IN
        && !request.resource.data.keys().hasAny(['email', 'phone', 'phoneNumber'])
        && profileOk(request.resource.data)                        // PREVIEW-LIFT GUARD
        && handleLinkOk(request.resource.data)                     // HANDLES claim
        && suspendOk(request.resource.data);                       // GPCHAT LIFT R2

      match /blocks/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.blockerUid == uid
          && request.resource.data.targetUid == targetUid
          && memberSite(request.resource.data);                    // HUB SIGN-IN
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /following/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        // v2 fix: follow never worked. ownEdge() is declared outside this match, so it can't see
        // {uid} (rules error = deny), and live clients omit followerUid. The path already pins the owner.
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.auth.uid != targetUid
          && memberSite(request.resource.data)                     // HUB SIGN-IN
          && (!request.resource.data.keys().hasAny(['followerUid']) || request.resource.data.followerUid == uid)
          && request.resource.data.targetUid == targetUid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /mutes/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.auth.uid != targetUid
          && memberSite(request.resource.data)                     // HUB SIGN-IN
          && request.resource.data.muterUid == uid
          && request.resource.data.targetUid == targetUid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /bookmarks/{postId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.postId == postId
          && factorySite(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /hidden/{postId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.postId == postId
          && factorySite(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // In-app notifications inbox (Chat stretch / Notifs MVP)
      match /notifications/{notifId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if signedIn() && request.auth.uid == uid;
        allow create: if emailVerified()
          && request.resource.data.toUid == uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid != uid
          && (factorySite(request.resource.data)
              || (hubSite(request.resource.data) && request.resource.data.type == 'follow'))  // HUB SIGN-IN: follow alerts only
          && request.resource.data.type in ['reply', 'like', 'follow', 'mention', 'report', 'report_update']  // NOTIFS-REPORTS 2026-10-22 + A9 report_update
          && request.resource.data.keys().hasOnly(['toUid', 'fromUid', 'type', 'siteId', 'postId', 'read', 'text', 'createdAt'])  // NOTIFS-REPORTS 2026-10-22
          && (!request.resource.data.keys().hasAny(['text'])
              || (request.resource.data.text is string && request.resource.data.text.size() <= 280))
          && (!request.resource.data.keys().hasAny(['createdAt'])
              || request.resource.data.createdAt == request.time)
          && (request.resource.data.type != 'report' || uid == 'o774wL9hUVSi19EkDCgLqQomP8i2')  // CLO #7 report alert goes to the admin only
          && (request.resource.data.type != 'report_update' || request.auth.uid == 'o774wL9hUVSi19EkDCgLqQomP8i2')  // A9: report status updates come from the admin only
          && request.resource.data.read == false;
      }
    }

    // HANDLES (27chat PR 53). Shared across rooms: one SubX identity, one namespace.
    // Signed-in get only. list is denied so the handle-to-uid map cannot be enumerated.
    // Create is a new doc whose uid is the caller, and the same transaction must leave
    // users/{uid}.handle equal to this id. No update. Delete only by the owner, and only
    // when users.handle no longer equals this id after the write.
    match /handles/{handle} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && claimHandleOk(handle)
        && !callerHandleBlocked()
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.keys().hasOnly(['uid', 'siteId'])
        && request.resource.data.uid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['siteId']) || memberSite(request.resource.data))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('handle', '') == handle;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (
          !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('handle', '') != handle
        );
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if emailVerified()
        && request.resource.data.reporterUid == request.auth.uid
        && factorySite(request.resource.data)
        && request.resource.data.postId is string
        && request.resource.data.postId.size() <= 200                      // NOTIFS-REPORTS 2026-10-22
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40                       // PREVIEW-LIFT GUARD
        && request.resource.data.keys().hasOnly(['siteId', 'postId', 'storyId', 'targetUid', 'reporterUid', 'reason', 'status', 'createdAt'])  // NOTIFS-REPORTS 2026-10-22
        && (!request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status == 'open')                     // NOTIFS-REPORTS 2026-10-22: a reporter cannot pre-close a report
        && (!request.resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt == request.time);           // PREVIEW-LIFT GUARD
      allow update, delete: if isAdmin();
    }

    // ===== AUTOHIDE-ON-REPORT (2026-10-22) =====
    // Public hide marker { siteId, postId, reportId, reporterUid, createdAt } — carries NO post text,
    // NO media URL, NO reason string. Every client subscribes to hides for its room and strips hidden
    // postIds / parentIds / storyIds before any text or image renders.
    // Created either by admin (CLI / console / mass-hide) or by a verified member in the SAME atomic
    // batch as a /reports/{reportId} doc whose reason is in ['ncii', 'copyright', 'violent_offensive', 'hate', 'impersonation', 'csam'].
    // ONLY the admin (isAdmin, uid o774wL9hUVSi19EkDCgLqQomP8i2) can restore by deleting the hide doc.
    match /hides/{hideId} {
      function hideTargetExists(d) {
        return !d.postId.matches('^uid:.*')
          && (d.postId.matches('^story:.*')
            ? exists(/databases/$(database)/documents/stories/$(d.postId[6:]))
            : exists(/databases/$(database)/documents/posts/$(d.postId)));
      }
      function hideReportOk(d) {
        return d.reportId is string
          && d.reportId.size() > 0
          && d.reportId.size() <= 120
          && hideTargetExists(d)
          && existsAfter(/databases/$(database)/documents/reports/$(d.reportId))
          && getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.reporterUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.siteId == d.siteId
          && getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.postId == d.postId
          && getAfter(/databases/$(database)/documents/reports/$(d.reportId)).data.reason in ['ncii', 'copyright', 'violent_offensive', 'hate', 'impersonation', 'csam'];
      }
      function hideRateOk() {
        return existsAfter(rlPath())
          && getAfter(rlPath()).data.lastHideAt == request.time;
      }
      allow read: if true;
      allow create: if (isAdmin() || emailVerified())
        && factorySite(request.resource.data)
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.postId.size() <= 200
        && hideId == request.resource.data.siteId + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly(['siteId', 'postId', 'reportId', 'reporterUid', 'createdAt', 'reason'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (isAdmin() || (
          !request.resource.data.keys().hasAny(['reason'])
          && hideReportOk(request.resource.data)
          && hideRateOk()
        ));
      allow update: if false;
      allow delete: if isAdmin();
    }
    // ===== END AUTOHIDE-ON-REPORT =====

    match /sites/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.siteId == siteId
        && request.resource.data.killed is bool;
      allow delete: if false;

      // From factory-template/membernests.rules.snippet. Not confirmed in deployed rules; the live + button needs it.
      match /memberNests/{uid}/rooms/{slug} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if emailVerified()
          && request.auth.uid == uid
          && factorySite({'siteId': siteId})
          && nestSlugOk(slug)
          && request.resource.data.siteId == siteId
          && request.resource.data.ownerUid == uid
          && request.resource.data.slug == slug
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 40
          && request.resource.data.nav == true
          && request.resource.data.parent == null
          && request.resource.data.kind == 'user';
        allow update, delete: if signedIn()
          && request.auth.uid == uid
          && resource.data.ownerUid == uid;
      }
    }

    // ===== PREVIEW-LIFT GUARD: per-user write throttle =====
    // rateLimits/{uid}: { lastPostAt, lastMsgAt, day, dayCount, burstStart, burstCount }
    // Gap: 20s between posts/replies, 2s between DMs. Daily cap: 50 posts+replies (UTC day).
    // Burst cap (2026-10-12): at most 5 posts+replies per 10-minute window (window opens at the
    // first post after the previous window ends). Steward admin o774wL9h... is exempt (postThrottled
    // skips the rateLimits check for isAdmin(); Path A drips also run outside rules).
    match /rateLimits/{uid} {
      function rlKeysOk(d) {
        return d.keys().hasOnly([
          'lastPostAt', 'lastMsgAt', 'day', 'dayCount', 'burstStart', 'burstCount',
          'lastHideAt', 'hideDay', 'hideDayCount'
        ]);
      }
      function hideBump(before, after) {
        return after.lastHideAt == request.time
          && (!before.keys().hasAny(['lastHideAt'])
              || request.time > before.lastHideAt + duration.value(60, 's'))
          && (!after.keys().hasAny(['hideDay', 'hideDayCount']) || (
            after.hideDay == request.time.date()
            && ((before.keys().hasAny(['hideDay']) && before.hideDay == request.time.date())
                  ? (after.hideDayCount == before.hideDayCount + 1 && after.hideDayCount <= 5)
                  : after.hideDayCount == 1)
          ));
      }
      function burstOk(before, after) {
        return (before.keys().hasAll(['burstStart', 'burstCount'])
                && request.time < before.burstStart + duration.value(10, 'm'))
          ? (after.burstStart == before.burstStart
              && after.burstCount == before.burstCount + 1 && after.burstCount <= 5)
          : (after.burstStart == request.time && after.burstCount == 1);
      }
      function postBump(before, after) {
        return after.lastPostAt == request.time
          && (!before.keys().hasAny(['lastPostAt'])
              || request.time > before.lastPostAt + duration.value(20, 's'))
          && after.day == request.time.date()
          && ((before.keys().hasAny(['day']) && before.day == request.time.date())
                ? (after.dayCount == before.dayCount + 1 && after.dayCount <= 50)
                : after.dayCount == 1)
          && burstOk(before, after);
      }
      function msgBump(before, after) {
        return after.lastMsgAt == request.time
          && (!before.keys().hasAny(['lastMsgAt'])
              || request.time > before.lastMsgAt + duration.value(2, 's'));
      }
      function changed(before, after) {
        return after.diff(before).affectedKeys();
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && rlKeysOk(request.resource.data)
        && request.resource.data.keys().hasAny(['lastPostAt', 'lastMsgAt', 'lastHideAt'])
        && (!request.resource.data.keys().hasAny(['lastPostAt']) || postBump({}, request.resource.data))
        && (!request.resource.data.keys().hasAny(['lastMsgAt']) || msgBump({}, request.resource.data))
        && (!request.resource.data.keys().hasAny(['lastHideAt']) || hideBump({}, request.resource.data));
      allow update: if signedIn() && request.auth.uid == uid
        && rlKeysOk(request.resource.data)
        && (
          (changed(resource.data, request.resource.data).hasOnly(['lastPostAt', 'day', 'dayCount', 'burstStart', 'burstCount'])
            && postBump(resource.data, request.resource.data))
          || (changed(resource.data, request.resource.data).hasOnly(['lastMsgAt'])
            && msgBump(resource.data, request.resource.data))
          || (changed(resource.data, request.resource.data).hasOnly(['lastHideAt', 'hideDay', 'hideDayCount'])
            && hideBump(resource.data, request.resource.data))
        );
      allow delete: if isAdmin();
    }
    // ===== END PREVIEW-LIFT GUARD throttle =====

    match /stories/{storyId} {
      // AUTOHIDE-ON-REPORT (2026-10-22): single-doc get is denied to non-admin when story is hidden.
      allow list: if factorySite(resource.data);
      allow get: if factorySite(resource.data) && (
        isAdmin()
        || (
          !exists(/databases/$(database)/documents/hides/$(resource.data.siteId + '_story:' + storyId))
          && !exists(/databases/$(database)/documents/hides/$(resource.data.siteId + '_' + storyId))
        )
      );
      allow create: if emailVerified()
        && notKilled(request.resource.data.siteId)
        && request.auth.uid == request.resource.data.authorUid
        && factorySite(request.resource.data)
        && !noUploadsSite(request.resource.data.siteId)      // GPCHAT LIFT U3: stories off
        && hasStoryFields(request.resource.data)
        && memberStoryOk(request.resource.data)                 // v2 GUARD
        && authorTypeOk(request.resource.data);                 // GROWTH CONSOLE
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Factory-wide DMs (was gpchat-only in subx-og) — block-aware
    match /conversations/{convId} {
      allow read: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(convId))
            || (dmSite(resource.data)                             // HUB DM TOGGLE
                && request.auth.uid in resource.data.participants));
      allow create: if emailVerified()
        && dmSite(request.resource.data)                          // HUB DM TOGGLE
        && notKilled(request.resource.data.siteId)
        && request.auth.uid in request.resource.data.participants
        && twoParticipants(request.resource.data)
        && !blockedEitherWay(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update: if emailVerified()
        && dmSite(resource.data)                                  // HUB DM TOGGLE
        && request.auth.uid in resource.data.participants
        && dmUnreadUpdate()
        && !blockedEitherWay(resource.data.participants[0], resource.data.participants[1]);
      allow delete: if false;

      match /messages/{msgId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        function convAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        allow read: if signedIn()
          && (!exists(/databases/$(database)/documents/conversations/$(convId))
              || (request.auth.uid in conv().participants && dmSite(conv())));  // HUB DM TOGGLE
        allow create: if emailVerified()
          && request.resource.data.fromUid == request.auth.uid
          && authorTypeOk(request.resource.data)                   // GROWTH CONSOLE
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && (isAdmin() || spamFree(request.resource.data.text))   // PREVIEW-LIFT GUARD
          && msgThrottled(request.resource.data.siteId)            // PREVIEW-LIFT GUARD
          && dmSite(request.resource.data)                        // HUB DM TOGGLE
          && notKilled(request.resource.data.siteId)
          && request.auth.uid in convAfter().participants
          && dmSite(convAfter())                                  // HUB DM TOGGLE
          && request.resource.data.siteId == convAfter().siteId
          && !blockedEitherWay(convAfter().participants[0], convAfter().participants[1]);
        allow update, delete: if false;
      }
    }

    // GROWTH CONSOLE (2026-10-22): daily human vs steward stats. Admin only, read and write.
    // The nightly script writes with admin OAuth over REST (bypasses rules); this keeps every client out.
    match /stats/{siteId} {
      allow read, write: if isAdmin();
      match /daily/{day} {
        allow read, write: if isAdmin();
      }
    }
  }
}

