rules_version = '2';

//SubX Factory — Firebase Storage Security Rules (AUTOHIDE-ON-REPORT DRAFT, 2026-10-22)
//Project: subx-skins (shared across all rooms)
//Base: live storage.live.rules (verified 2026-10-22) + cross-service firestore.exists() hide check.
//
//IMPORTANT — WHY DOWNLOAD-TOKEN URLS STILL RESOLVE UNTIL TOKEN ROTATION:
//  1. Firebase Storage `allow read` rules govern requests through the Firebase Storage SDK (`getDownloadURL()`,
//     `getBlob()`, `getBytes()`) and un-tokened REST requests (`GET /v0/b/<bucket>/o/<object>?alt=media`).
//  2. However, `post.imageUrl` and `story.mediaUrl` stored in Firestore are `getDownloadURL()` URLs containing
//     `?alt=media&token=<firebaseStorageDownloadTokens UUID>`. In Google Cloud / Firebase Storage, presenting a
//     valid download token in the query string BYPASSES Storage Security Rules at the edge and serves the object
//     directly (and CDN/browser caches may hold it for `Cache-Control` duration).
//  3. Therefore, stopping image rendering requires TWO layers:
//     - Layer A (Instant, v1 free-tier, 0 Cloud Functions): Every client subscribes to `/hides` and strips hidden
//       posts/stories before `renderPostMedia` / `renderPost` / `sharePost` / `paintStoryViewer` ever emit an
//       `<img src>` or `<video src>` tag. And `/posts/{postId}` single-doc `get` is denied in Firestore rules so
//       no uncached client can fetch the `imageUrl` token of a hidden post.
//     - Layer B (Token revocation for someone who already copied the raw `firebasestorage.googleapis.com` URL):
//       Delete or rotate the object's `metadata.firebaseStorageDownloadTokens` via Admin SDK (in `hide_content.cjs`
//       or the `report-alert` Cloud Function's `revokeHiddenPostMediaToken` helper). Once `firebaseStorageDownloadTokens`
//       is cleared/rotated on the GCS object, the old `?token=...` URL immediately returns HTTP 403 Forbidden, and
//       any new `getDownloadURL()` call is blocked by the `firestore.exists(.../hides/...)` rule below!
//
//NOTE ON PATH NAMING FOR `firestore.exists()`:
//  Current client uploads write to `posts/{siteId}/{uid}/{ts}_{rand}.{ext}` (filename is NOT `postId`).
//  Therefore, path-level `firestore.exists` on `/posts/{siteId}/{uid}/{fileName}` can check a hide marker keyed by
//  `{siteId}_{fileName}` when future uploads name the object `{postId}.{ext}`, OR check an author-level suspension/hide
//  marker `/hides/{siteId}_uid:{uid}`. Both checks are included below.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == 'o774wL9hUVSi19EkDCgLqQomP8i2';
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    function isStoryMedia() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)')
        || request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }
    // GPCHAT LIFT U3 (2026-10-18): no user uploads or stories in gpchat.
    function uploadsAllowed(siteId) {
      return !(siteId in ['gpchat']);
    }
    // AUTOHIDE-ON-REPORT (2026-10-22): block SDK/un-tokened reads when a hide marker exists for the object name or author.
    function notHiddenObject(siteId, uid, fileName) {
      return isAdmin() || (
        !firestore.exists(/databases/(default)/documents/hides/$(siteId + '_' + fileName))
        && !firestore.exists(/databases/(default)/documents/hides/$(siteId + '_uid:' + uid))
      );
    }

    // Post images: 5 MB max, owner path, verified email, room allows uploads
    match /posts/{siteId}/{uid}/{fileName} {
      allow read: if notHiddenObject(siteId, uid, fileName);
      allow create, update: if emailVerified()
        && request.auth.uid == uid
        && uploadsAllowed(siteId)
        && isImage()
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Story media: 15 MB max (image or short video), owner path, verified email, room allows uploads
    match /stories/{siteId}/{uid}/{fileName} {
      allow read: if notHiddenObject(siteId, uid, fileName);
      allow create, update: if emailVerified()
        && request.auth.uid == uid
        && uploadsAllowed(siteId)
        && isStoryMedia()
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Avatars: 2 MB max, owner path, verified email
    match /avatars/{siteId}/{uid}/{fileName} {
      allow read: if notHiddenObject(siteId, uid, fileName);
      allow create, update: if emailVerified()
        && request.auth.uid == uid
        && isImage()
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
  }
}
